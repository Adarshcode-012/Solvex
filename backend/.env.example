# ─────────────────────────────────────────────────────────────────
# SolveX v2 — Environment Variables
# INSTRUCTIONS: Copy this file → rename to .env → fill in your keys
# ─────────────────────────────────────────────────────────────────

# ── AI Keys (add whichever you have — at least ONE required) ──────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Code Execution (Judge0) ───────────────────────────────────────
# Get from: https://rapidapi.com/judge0-official/api/judge0-ce
# Free tier = 100 submissions/day
JUDGE0_API_KEY=
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com

# ── Memory Storage ────────────────────────────────────────────────
# Local ChromaDB path (all memory stays on your machine)
CHROMA_DB_PATH=./memory/chroma_db
MEMORY_BACKEND=chroma

# ── Guest Sessions ─────────────────────────────────────────────────
# Required in production. Signs the anonymous httpOnly guest session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GUEST_SESSION_SECRET=
# APP_SECRET_KEY is accepted as a backwards-compatible fallback.
APP_SECRET_KEY=

# Requests/minute allowed per guest on /solve and /solve-image
SOLVE_RATE_LIMIT=5/minute
RATE_LIMIT_STORAGE_URI=memory://
# Set both values for multi-process/production deployments.
REDIS_URL=

# ── Model versions (override if a provider deprecates a version) ──
CLAUDE_MODEL=claude-sonnet-4-20250514
GPT4O_MODEL=gpt-4o
GPT4O_MINI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini/gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini/gemini-1.5-flash

# ── App Config ────────────────────────────────────────────────────
JUDGE_MAX_ITERATIONS=5
LOG_LEVEL=INFO
# Change to production when deploying — this enforces guest session and CORS settings.
APP_ENV=development
# Comma-separated allowed origins — set to your real frontend domain(s) in production.
# Avoid leaving this as "*" once deployed.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
