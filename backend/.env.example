# ─────────────────────────────────────────────────────────────────
# SolveX v2 — Environment Variables
# INSTRUCTIONS: Copy this file → rename to .env → fill in your keys
# ─────────────────────────────────────────────────────────────────

# ── AI Keys (add whichever you have — at least ONE required) ──────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Code Execution (Judge0) ───────────────────────────────────────
# Get from: https://rapidapi.com/judge0-official/api/judge0-ce
# Free tier = 100 submissions/day
JUDGE0_API_KEY=
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com

# ── Memory Storage ────────────────────────────────────────────────
# Local ChromaDB path (all memory stays on your machine)
CHROMA_DB_PATH=./memory/chroma_db
MEMORY_BACKEND=chroma

# ── Guest Sessions ─────────────────────────────────────────────────
# Required in production. Signs the anonymous httpOnly guest session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GUEST_SESSION_SECRET=
# APP_SECRET_KEY is accepted as a backwards-compatible fallback.
APP_SECRET_KEY=

# Rate limits for /solve, /solve-image, and /explain (Redis storage required in production)
TRUSTED_PROXIES=
IP_SOLVE_RATE_LIMIT=10/minute
IP_SOLVE_DAILY_RATE_LIMIT=100/day
GUEST_SOLVE_RATE_LIMIT=5/minute
NEW_GUESTS_PER_IP_PER_HOUR=20
GLOBAL_DAILY_SOLVE_CAP=200
RATE_LIMIT_STORAGE_URI=memory://
# In development, leave REDIS_URL empty unless Redis is running locally.
# Set both values for production deployments or when local Redis is running.
REDIS_URL=
# Redis password for Docker Compose. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# Optional server-side admin access. Keep this out of all VITE_ variables.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── Model IDs (UNVERIFIED - no key tested) ────────────────────────
# Claude source: https://docs.anthropic.com/en/docs/about-claude/models/overview
# OpenAI source: https://platform.openai.com/docs/models
# Gemini source: https://ai.google.dev/gemini-api/docs/models
# Use keys before relying on these defaults.
# Gemini IDs need the gemini/ prefix.
MODEL_CLAUDE=anthropic/claude-sonnet-5-5
MODEL_GPT4O=openai/gpt-6.1-sol
MODEL_GPT4O_MINI=openai/gpt-6-luna
MODEL_GEMINI=gemini/gemini-3.8-flash
MODEL_GEMINI_FLASH=gemini/gemini-3.8-flash
# Legacy names still accepted: CLAUDE_MODEL, GPT4O_MODEL, GEMINI_MODEL.

# ── App Config ────────────────────────────────────────────────────
JUDGE_MAX_ITERATIONS=5
LOG_LEVEL=INFO
# Change to production when deploying — this enforces guest session and CORS settings.
APP_ENV=development
# Comma-separated allowed origins — set to your real frontend domain(s) in production.
# Avoid leaving this as "*" once deployed.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
