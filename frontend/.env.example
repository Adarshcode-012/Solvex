# ─────────────────────────────────────────────────────────────────
# SolveX v2 Frontend — Environment Variables
# INSTRUCTIONS: Copy this file → rename to .env → fill in values
# ─────────────────────────────────────────────────────────────────

# Backend URL. Leave unset in local dev (Vite proxies /api → localhost:8000).
# Set to your deployed backend's URL in production, e.g. https://api.yourapp.com
VITE_API_URL=

# Must exactly match APP_SECRET_KEY in the backend's .env.
# Only required if the backend has APP_SECRET_KEY set (which it must, in production).
VITE_APP_API_KEY=
